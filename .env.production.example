# Copy to .env.production locally; enter secrets there or in the host dashboard.
# Keep the development .env unchanged.
# Supabase transaction pooler for Vercel (use the URI supplied by Supabase).
# Include pgbouncer=true&connection_limit=1 for this Prisma 6 application.
DATABASE_URL=
# Direct/session-pooler URI for migrations; do not use transaction pooling for migrations.
# This is a deployment input, not an automatically consumed Prisma setting.
MIGRATION_DATABASE_URL=
AUTH_SECRET=
APP_URL=
SEED_SAMPLE_DATA=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Can be configured after the initial protected deployment.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MANUS_API_KEY=
REPORT_FONT_PATH=
TRUST_PROXY=false
